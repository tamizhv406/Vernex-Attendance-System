# Copy this file to ".env" (setup.bat does it for you).
# Leave DATABASE_URL commented out to use a local SQLite file (easiest, nothing to configure).
# To use Supabase PostgreSQL instead, uncomment it and fill in your own values.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# On PostgreSQL the backend only checks the schema when it starts (apply backend/migrations first;
# scripts/check_database.py shows what is missing). true: create and change tables at every start.
# DATABASE_AUTO_UPGRADE=false
# Connect as the least-privilege account of migration 009 (vernex_app), not as postgres: see
# docs/RUNBOOK.md. A remote PostgreSQL server is always reached encrypted (sslmode=require).
# Exact addresses (comma-separated) of pages on ANOTHER origin that may read the backend's answers,
# for example https://console.example.com. Leave it empty: the console reaches the backend through
# /api on its own address and needs none. Patterns, "*" and "null" are ignored.
FRONTEND_ORIGIN=
DEFAULT_TIMEZONE=Asia/Kolkata

# Login. JWT_SECRET signs the login tokens and is required: the backend does not start without it.
# Do not type one by hand and never commit it. This command writes a random one into .env without
# showing it (setup.bat runs it for you):
#   .venv\Scripts\python scripts\create_jwt_secret.py
JWT_SECRET=
# Optional; these are the defaults.
# AUTH_ACCESS_MINUTES=15
# AUTH_REFRESH_DAYS=7
# A login not renewed for this long ends (the console also logs out after 30 minutes without a
# click or a key; a running scanner keeps it awake). 0 switches it off.
# AUTH_IDLE_MINUTES=30
# The path the browser uses to reach the auth routes. /api/auth when the frontend forwards /api to
# the backend (the normal set-up); /auth only if browsers call the backend's address directly.
# AUTH_COOKIE_PATH=/api/auth
# /docs and /openapi.json list every route to anyone who asks. Switch on only on your own machine.
# API_DOCS=false

# Face settings (all optional; these are the defaults). See the root README for what the numbers mean
# and scripts/evaluate_recognition.py for how they were measured.
# FACE_MATCH_THRESHOLD=0.60
# FACE_MATCH_MARGIN=0.05
# FACE_CONFIRM_FRAMES=3
# FACE_CONFIRM_SCORE=0.75
# FACE_ENROLL_DUPLICATE_SCORE=0.85
# FACE_LIVENESS=true
# FACE_SCAN_LOG=true
# FACE_LIVENESS_THRESHOLD=0.50
# FACE_LIVENESS_CONFIDENT=0.70
# FACE_CHALLENGE=always
# FACE_ENROLL_MODE=quick
# FACE_ENROLL_QUICK_STEPS=front,left,right
# FACE_ENROLL_BURST_FRAMES=3
# FACE_TF_THREADS=4
# FACE_TIMING_LOG=true
# Largest camera frame accepted, and the most pixels it may unpack into.
# FACE_MAX_UPLOAD_BYTES=2000000
# FACE_MAX_IMAGE_PIXELS=16777216

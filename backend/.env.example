# Copy this file to ".env" (setup.bat does it for you).
# Leave DATABASE_URL commented out to use a local SQLite file (easiest, nothing to configure).
# To use Supabase PostgreSQL instead, uncomment it and fill in your own values.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
FRONTEND_ORIGIN=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata

# Face settings (all optional; these are the defaults). See the root README for what the numbers mean
# and scripts/evaluate_recognition.py for how they were measured.
# FACE_MATCH_THRESHOLD=0.60
# FACE_MATCH_MARGIN=0.05
# FACE_CONFIRM_FRAMES=3
# FACE_CONFIRM_SCORE=0.75
# FACE_ENROLL_DUPLICATE_SCORE=0.85
# FACE_LIVENESS=true
# FACE_SCAN_LOG=true
# FACE_LIVENESS_THRESHOLD=0.50
# FACE_LIVENESS_CONFIDENT=0.70
# FACE_CHALLENGE=always
# FACE_ENROLL_MODE=quick
# FACE_ENROLL_QUICK_STEPS=front,left,right
# FACE_ENROLL_BURST_FRAMES=3

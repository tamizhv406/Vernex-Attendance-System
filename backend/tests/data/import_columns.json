{
  "about": "The column headers of every bulk upload. Checked against backend/app/services/import_service.py (tests/test_import_templates.py) and against frontend/src/lib/imports.js (src/lib/imports.test.js), so the upload dialog always lists the columns the backend reads.",
  "courses": {
    "required": ["course_code", "course_name"],
    "optional": ["description"]
  },
  "batches": {
    "required": ["batch_name", "course_code"],
    "optional": ["batch_level"]
  },
  "students": {
    "required": ["student_id", "full_name", "parent_contact", "course_code", "batch_name"],
    "optional": ["parent_name", "level_class", "joining_date", "notes"]
  },
  "staff": {
    "required": ["staff_id", "full_name", "contact_number"],
    "optional": ["email", "course_code", "batch_name", "level_class", "joining_date", "notes"]
  },
  "members": {
    "required": ["member_id", "full_name", "contact_number"],
    "optional": ["email", "course_code", "batch_name", "level_class", "joining_date", "notes"]
  }
}
